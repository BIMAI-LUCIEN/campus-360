# Mobile API — Environment Variables
# Copy this file to .env.local and fill in the values.

# ── Database (PostgreSQL via Supabase) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres.<user>:<password>@aws-1-eu-north-1.pooler.supabase.com:6543/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=<your-secret-here>
# The base URL where this API is hosted (must match Vercel custom domain)
BETTER_AUTH_URL=https://api.campus360b.site

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=<your-resend-key>
MAIL_FROM="Campus 360 <onboarding@resend.dev>"

# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-key>
OPENROUTER_MODEL=openrouter/free
