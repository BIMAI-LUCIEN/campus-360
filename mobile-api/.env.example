# Mobile API — Environment Variables
# Copy this file to .env.local and fill in the values.

# ── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Same DATABASE_URL as admin-app — both apps share the same DB.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# IMPORTANT: must match across all apps (admin-app, mobile-api) so sessions
# issued by one can be verified by the other.
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# The base URL where this API is hosted (must match Vercel custom domain).
# Vercel auto-sets this during builds; override here only for local dev.
BETTER_AUTH_URL=https://api.campus360b.site

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=<your-resend-key>
# Must be a verified domain in Resend, or use the test address below.
# Until verified, emails only reach the address you signed up with.
MAIL_FROM="Campus 360 <onboarding@resend.dev>"
# Recipient of automated admin alerts (failed payment / failed application dispatch).
# Falls back to ADMIN_BOOTSTRAP_EMAIL, then to the first ADMIN_ALLOWED_EMAILS entry.
ADMIN_ALERT_EMAIL=

# Storage (required by PDF catalogue routes)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-key>
OPENROUTER_MODEL=openrouter/free

# Lancement gratuit (obligatoire en production)
FREE_LAUNCH_MODE=true
FREE_LAUNCH_UNTIL=
# Solde offert à la création du compte (1 coin = 1 FCFA)
STARTING_COINS=3000
# Coûts IA en crédits après le lancement gratuit
AI_COST_PASSAGE=1
AI_COST_CAREER_DOC=2
AI_COST_FULL_DOC=3

# Sécurité réseau (tâche 23.11)
# true seulement derrière Nginx (VPS) : sinon l'IP du client est falsifiable
TRUST_PROXY=true
# Origines web supplémentaires exactes, séparées par des virgules (sans joker).
# CORS_ALLOWED_ORIGINS est obsolète : il est encore lu, mais à migrer ici.
TRUSTED_EXTRA_ORIGINS=
# Chemin du certificat CA Supabase (TLS de la base vérifié en production)
DATABASE_SSL_CA_FILE=
