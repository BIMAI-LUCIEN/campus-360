# ==============================================================================
# Campus 360 Mobile API — Modèle de variables d'environnement
# ==============================================================================
# Copie ce fichier vers .env.local pour le développement local.
# En production (VPS), ces variables doivent être configurées dans l'environnement
# d'exécution ou dans le fichier de service systemd / PM2.
# ==============================================================================

# ── 1. Base de données (PostgreSQL via Supabase) ──────────────────────────────
# URL de connexion Postgres partagée (pooler de transactions sur le port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# false autorise les certificats auto-signés en dev ; en prod, utiliser DATABASE_SSL_CA_FILE
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Chemin absolu vers le certificat racine CA Supabase pour vérification stricte TLS en prod
DATABASE_SSL_CA_FILE=

# ── 2. Authentification (Better Auth) ─────────────────────────────────────────
# Clé secrète maîtresse (minimum 32 caractères, générer avec : openssl rand -hex 32)
# Doit être identique entre mobile-api et recruiter-web pour partager les sessions
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# URL publique absolue de cette API (ex. https://api.campus360b.site)
BETTER_AUTH_URL=https://api.campus360b.site
# Optionnel : identifiants OAuth Google pour l'authentification mobile et web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails administrateurs autorisés pour les accès sensibles
ADMIN_ALLOWED_EMAILS=
ADMIN_BOOTSTRAP_EMAIL=

# ── 3. Réseau, Origines et Sécurité ───────────────────────────────────────────
# true si l'API tourne derrière Nginx / reverse proxy de confiance (permet la lecture réelle d'IP)
TRUST_PROXY=true
# Origine deep-link de l'application mobile native
EXPO_APP_ORIGIN=campus360://
# Domaines web supplémentaires de confiance (séparés par virgules, sans joker)
TRUSTED_EXTRA_ORIGINS=
# Rétro-compatibilité pour origines CORS autorisées
CORS_ALLOWED_ORIGINS=

# ── 4. Stockage des fichiers et Médias ────────────────────────────────────────
# Clé secrète servant à signer les URLs sécurisées de téléchargement de documents
FILES_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
# URL publique du serveur de fichiers (ex. https://files.campus360b.site)
FILES_PUBLIC_URL=https://files.campus360b.site
# Répertoire local sur le VPS recevant les téléversements (images, sources, rapports)
UPLOAD_ROOT=/var/www/campus-360-uploads

# Identifiants Supabase REST / Storage (requêtes de catalogue et stockage PDF)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Cloudinary (stockage et prévisualisations des documents de catalogue)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ── 5. Intelligence Artificielle (OpenRouter) ──────────────────────────────────
# Clé d'API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=<your-openrouter-key>
# Modèle d'inférence par défaut (ex. google/gemini-2.0-flash-001 ou anthropic/claude-3.5-haiku)
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Plafond global d'appels IA par utilisateur par 24 h (toutes routes confondues)
AI_DAILY_LIMIT=60
# Barème des coûts IA en crédits/coins après la fin du lancement gratuit
AI_COST_PASSAGE=1
AI_COST_CAREER_DOC=2
AI_COST_FULL_DOC=3

# ── 6. Lancement gratuit & Portefeuille ────────────────────────────────────────
# Mode gratuit pour la phase de lancement (true ou false)
FREE_LAUNCH_MODE=true
# Date d'expiration ISO du lancement gratuit (ex. 2027-01-20T00:00:00.000Z)
FREE_LAUNCH_UNTIL=2027-01-20T00:00:00.000Z
# Solde de coins offert à chaque nouvel étudiant inscrit (1 coin = 1 FCFA)
STARTING_COINS=3000

# ── 7. Paiements Mobile Money (Nyole) ──────────────────────────────────────────
# false pour désactiver les paiements en dev ; si true, NYOLE_SECRET_KEY est obligatoire
PAYMENTS_ENABLED=true
# Clé publique API Nyole (af_test_pub_... ou af_live_pub_...)
NYOLE_PUBLIC_KEY=<your-nyole-public-key>
# Clé secrète API Nyole pour initier les paiements et vérifier les webhooks (af_test_sec_... ou af_live_sec_...)
NYOLE_SECRET_KEY=<your-nyole-secret-key>
# Optionnel : secret webhook dédié (si distinct de NYOLE_SECRET_KEY)
NYOLE_WEBHOOK_SECRET=
# URL de base de l'API Nyole (par défaut : https://app.nyole.com/api)
NYOLE_API_URL=https://app.nyole.com/api
# Rétro-compatibilité legacy (optionnel)
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_SECRET=

# ── 8. E-mails transactionnels (Resend) ───────────────────────────────────────
# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=<your-resend-api-key>
# Expéditeur vérifié pour les e-mails de validation et réinitialisation de mot de passe
MAIL_FROM="Campus 360 <onboarding@resend.dev>"
# Destinataire des alertes d'incidents administratifs critiques
ADMIN_ALERT_EMAIL=

# ── 9. WhatsApp (Evolution API) ───────────────────────────────────────────────
# URL de l'instance Evolution API sur le VPS (ex. http://localhost:8080)
EVOLUTION_API_URL=http://localhost:8080
# Clé d'API globale configurée sur Evolution API
EVOLUTION_API_KEY=

# ── 10. Scraping et Pipeline de stages n8n ────────────────────────────────────
# Secret d'authentification pour le webhook d'ingestion d'offres n8n (X-N8N-API-KEY)
N8N_INGESTION_SECRET=
# URL du webhook n8n pour le dispatch des candidatures de stages
N8N_STAGE_WEBHOOK_URL=http://localhost:5678/webhook/stage-applications
# Secret pour l'interface de revue manuelle des offres de stage
STAGES_REVIEW_SECRET=

# ── 11. Moteur d'exportation PDF (Puppeteer / Chromium) ────────────────────────
# Chemin vers le binaire Chromium headless installé sur le VPS Ubuntu
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
# Secret optionnel pour sonder la santé du moteur d'export PDF (/api/health/pdf)
HEALTH_PDF_SECRET=
