{
  "expo": {
    "name": "Campus 360",
    "slug": "campus-360",
    "scheme": "campus-bordes",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campus360b.app"
    },
    "android": {
      "package": "com.campus360b.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-updates",
        {
          "channels": [
            "preview"
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "49ce85c3-c644-4a6c-a492-2596e5047c74"
      }
    },
    "owner": "miguelvinijr237",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/098589af-cd81-41d3-8c74-173bd02396a5"
    }
  }
}
