# ───────────────────────────────────────────────────────────────────────────
# Campus 3602 mobile (Expo) — environment template
# ───────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in real values. All variables
# prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time, so do
# NOT put secrets here — only publishable URLs and the anon public key.
#
# The admin-server-only secrets (BETTER_AUTH_SECRET, SUPABASE_SERVICE_ROLE_KEY,
# NOTCHPAY_PRIVATE_KEY, etc.) live in `admin-app/.env.local` only.
# ───────────────────────────────────────────────────────────────────────────

# ─── Supabase (public — anon key only) ──────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://zlzwoqqnkvxndmtnzdsm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── AI proxy ───────────────────────────────────────────────────────────────
# Path on the admin Next.js server that forwards AI calls to OpenRouter.
# In dev on Android/iOS, replace `localhost` with the LAN IP of your dev
# machine (e.g. http://192.168.1.10:3001) so the phone can reach it.
EXPO_PUBLIC_AI_PROXY_URL=http://YOUR_PC_LAN_IP:3001/api/ai/pdf-chat

# ─── Auth server ────────────────────────────────────────────────────────────
# Used by the native (iOS/Android) build to reach Better Auth. In the web
# build the auth client uses EXPO_PUBLIC_AUTH_WEB_URL so localhost works.
EXPO_PUBLIC_AUTH_URL=http://YOUR_PC_LAN_IP:3001
EXPO_PUBLIC_AUTH_WEB_URL=http://localhost:3001

# ─── Expo build settings ────────────────────────────────────────────────────
# Skip Expo's dependency-validation step (faster, but less safe). Set to 0
# when you want strict checks during a release build.
EXPO_NO_DEPENDENCY_VALIDATION=1
EXPO_NO_TELEMETRY=1
