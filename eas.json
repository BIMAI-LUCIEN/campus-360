{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_URL": "https://api.campus360b.site",
        "EXPO_PUBLIC_AUTH_WEB_URL": "https://admin.campus360b.site",
        "EXPO_PUBLIC_ADMIN_URL": "https://admin.campus360b.site"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_URL": "https://api.campus360b.site",
        "EXPO_PUBLIC_AUTH_WEB_URL": "https://admin.campus360b.site",
        "EXPO_PUBLIC_ADMIN_URL": "https://admin.campus360b.site"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {}
  }
}
