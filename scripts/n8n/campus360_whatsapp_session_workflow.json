    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst data = body.data || body;\nconst state = (data.state || body.state || '').toLowerCase();\nconst instance = body.instance || data.instance || '';\nlet sender = body.sender || data.sender || '';\n\nlet rawPhone = instance.replace('student-', '').replace(/[^0-9]/g, '');\nif (!rawPhone && sender) {\n  rawPhone = sender.split('@')[0].replace(/[^0-9]/g, '');\n}\n\nlet phone9 = '';\nlet phone12 = '';\n\nif (rawPhone.startsWith('237') && rawPhone.length === 12) {\n  phone12 = rawPhone;\n  phone9 = rawPhone.slice(3);\n} else if (rawPhone.length === 9) {\n  phone9 = rawPhone;\n  phone12 = '237' + rawPhone;\n} else {\n  phone9 = rawPhone;\n  phone12 = rawPhone;\n}\n\nconst isConnected = state === 'open';\n\nreturn [{\n  json: {\n    instance,\n    state,\n    isConnected,\n    phone9,\n    phone12,\n    rawPhone,\n    linkedAt: new Date().toISOString()\n  }\n}];"
      },
