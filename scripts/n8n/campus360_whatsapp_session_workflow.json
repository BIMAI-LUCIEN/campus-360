      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst rawPhone = (body.phone || body.phoneNumber || '').toString().trim();\nlet digits = rawPhone.replace(/[^0-9]/g, '');\n\nif (digits.startsWith('00')) {\n  digits = digits.slice(2);\n}\nif (digits.length === 9 && digits.startsWith('6')) {\n  digits = '237' + digits;\n}\n\nconst normalizedPhone = digits || '237672364124';\nconst phone12 = normalizedPhone.length === 12 ? normalizedPhone : ('237' + normalizedPhone);\nconst phone9 = normalizedPhone.length === 12 ? normalizedPhone.slice(3) : normalizedPhone;\nconst instanceName = body.instanceName || `student-${normalizedPhone}`;\nconst action = (body.action || 'pair').toLowerCase().trim();\n\nreturn [{\n  json: {\n    rawPhone,\n    normalizedPhone,\n    phone9,\n    phone12,\n    instanceName,\n    action,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
