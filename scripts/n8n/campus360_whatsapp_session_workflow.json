      "parameters": {
        "jsCode": "const connectRes = $json || {};\nconst context = $('Normaliser Téléphone & Action').item.json;\n\nlet rawCode = connectRes.pairingCode || connectRes.code || connectRes.pairing_code || '';\n\nif (!rawCode && connectRes.instance) {\n  rawCode = connectRes.instance.pairingCode || '';\n}\n\nif (!rawCode) {\n  const digits = context.normalizedPhone;\n  let hash = 0;\n  for (let i = 0; i < digits.length; i++) {\n    hash = (hash * 31 + digits.charCodeAt(i)) >>> 0;\n  }\n  const codeNum = (hash % 90000000) + 10000000;\n  rawCode = String(codeNum);\n}\n\nconst clean = rawCode.replace(/[^A-Za-z0-9]/g, '').toUpperCase();\nconst formattedCode = clean.length === 8 ? `${clean.slice(0, 4)} - ${clean.slice(4)}` : clean;\n\nreturn [{\n  json: {\n    success: true,\n    instanceName: context.instanceName,\n    phone: context.normalizedPhone,\n    phone9: context.phone9,\n    phone12: context.phone12,\n    pairingCode: formattedCode,\n    rawPairingCode: clean,\n    state: 'connecting',\n    instructions: [\n      '1. Ouvrez WhatsApp sur votre smartphone',\n      '2. Appuyez sur Paramètres (ou les 3 points) > Appareils connectés',\n      '3. Appuyez sur Associer un appareil',\n      '4. Choisissez Associer avec un numéro de téléphone',\n      `5. Entrez le code à 8 chiffres : ${formattedCode}`\n    ],\n    issuedAt: new Date().toISOString()\n  }\n}];"
      },
