# ============================================
# Campus 360 — Landing Site
# ============================================
# Copie ce fichier en `.env.local` pour dev local.
# En prod (Vercel), configure via le dashboard.

# URL que le QR code de la section "Télécharger" encode.
# Par défaut : pointe vers la home du domaine (les étudiants ouvrent
# l'app via Expo Go en flashant ce QR).
# Pour tester avec ton instance Expo locale :
#   NEXT_PUBLIC_EXPO_URL=exp://10.136.239.235:8081
NEXT_PUBLIC_EXPO_URL=https://campus360b.site/app

# Domaine canonique (pour OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://campus360b.site