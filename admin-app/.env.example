# ───────────────────────────────────────────────────────────────────────────
# Campus 360 admin (Next.js) — environment template
# ───────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in real values. Anything marked
# "REQUIRED" must be set or the app will refuse to start.
#
# Generate a strong secret with:
#   openssl rand -base64 32
# ───────────────────────────────────────────────────────────────────────────

# ─── Auth (Better Auth) ────────────────────────────────────────────────────
# REQUIRED. Without this, auth.ts throws at boot.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public base URL where this admin server is reachable from the browser
# and from the mobile app. Use the LAN IP on a phone, localhost on web.
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated extra origins that Better Auth should trust (besides the
# defaults: campus-360://, localhost/127.0.0.1 on ports 3001/8081/8082,
# https://campus-360-hi97.vercel.app). Set this if you front the app behind a
# custom domain or run the Expo dev server on a different LAN host.
# TRUSTED_EXTRA_ORIGINS=https://campus360.app,https://staging.campus360.app

# Comma-separated list of admin emails. Anything in ADMIN_BOOTSTRAP_EMAIL is
# also included. These users get the `admin` role on first sign-in.
ADMIN_BOOTSTRAP_EMAIL=admin@campus360.local
ADMIN_ALLOWED_EMAILS=admin@campus360.local,your-google-email@gmail.com

# Expose the mobile scheme so the Expo deep link for password reset can
# redirect back into the app.
EXPO_APP_ORIGIN=campus-360://
EXPO_WEB_ORIGIN=http://localhost:8081

# ─── OAuth (Google) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ─── Database (Postgres / Supabase) ─────────────────────────────────────────
# The pooled Supabase connection string (port 6543) is recommended for serverless.
DATABASE_URL=postgresql://postgres.zlzwoqqnkvxndmtnzdsm:your-password@aws-1-eu-north-1.pooler.supabase.com:6543/postgres

# TLS verification. Defaults to `true` (recommended). Set to `false` ONLY for
# self-signed certs in local Docker dev. NEVER in production.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ─── Supabase (Storage + Auth) ──────────────────────────────────────────────
SUPABASE_URL=https://zlzwoqqnkvxndmtnzdsm.supabase.co
# Server-only key — used by API routes to sign PDF URLs and upload files.
# NEVER expose this to the mobile app; the mobile app uses the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Public anon key, exposed to the mobile app via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://zlzwoqqnkvxndmtnzdsm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── AI (OpenRouter) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=replace-with-openrouter-server-key
OPENROUTER_MODEL=openrouter/free

# ─── Email (SMTP — password reset / verification) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Campus 360 <your-email@gmail.com>

# ─── Payments (Notch Pay — Mobile Money top-ups) ────────────────────────────
# Sign up at https://notchpay.co and grab your private key from the dashboard.
# When this is empty, the wallet/topup route runs in MOCK SANDBOX mode (auto-
# approves after 3s). Required in production.
# NOTCHPAY_PRIVATE_KEY=your-notchpay-private-key

# Webhook signing secret — REQUIRED in production (the webhook refuses
# requests without a valid HMAC signature when NODE_ENV=production).
# NOTCHPAY_WEBHOOK_SECRET=your-notchpay-webhook-secret
